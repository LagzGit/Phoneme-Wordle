generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Activity {
  id             Int      @id @default(autoincrement())
  title          String
  type           String
  difficulty     String
  hint           String?
  instructions   String?
  maxGuesses     Int      @default(6)
  gridSize       Int      @default(10)
  allowDiagonals Boolean  @default(true)
  showHints      Boolean  @default(true)
  outputFileName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  words          Word[]

  @@index([type])
  @@index([updatedAt])
}

model Word {
  id         Int           @id @default(autoincrement())
  word       String
  hint       String?
  isTarget   Boolean       @default(false)
  position   Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  activityId Int
  activity   Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  phonemes   WordPhoneme[]

  @@unique([activityId, word])
  @@index([activityId])
}

model WordPhoneme {
  id       Int    @id @default(autoincrement())
  symbol   String
  position Int
  wordId   Int
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, position])
  @@index([wordId])
}
